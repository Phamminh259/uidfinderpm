# ===== Chung =====
NODE_ENV=production
APP_DOMAIN=uidfinder.site
PUBLIC_SITE_URL=https://uidfinder.site

# ===== PostgreSQL =====
POSTGRES_USER=uidfinder
POSTGRES_PASSWORD=DOI_MAT_KHAU_MANH
POSTGRES_DB=uidfinder
DATABASE_URL=postgresql://uidfinder:DOI_MAT_KHAU_MANH@postgres:5432/uidfinder?schema=public

# ===== Redis =====
REDIS_PASSWORD=DOI_MAT_KHAU_REDIS
REDIS_URL=redis://:DOI_MAT_KHAU_REDIS@redis:6379

# ===== Backend =====
BACKEND_PORT=4000
CORS_ORIGIN=https://uidfinder.site
JWT_ACCESS_SECRET=DOI_CHUOI_NGAU_NHIEN_DAI_64_KY_TU
JWT_REFRESH_SECRET=DOI_CHUOI_NGAU_NHIEN_KHAC_64_KY_TU
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
ANALYTICS_IP_SALT=DOI_CHUOI_NGAU_NHIEN_32_KY_TU
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
UID_RATE_LIMIT_PER_MINUTE=10
UID_CACHE_TTL_SECONDS=86400

# ===== Admin ban đầu (dùng cho script seed, xóa sau khi tạo) =====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=DOI_MAT_KHAU_ADMIN_MANH

# ===== Frontend =====
NEXT_PUBLIC_SITE_URL=https://uidfinder.site
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://backend:4000
